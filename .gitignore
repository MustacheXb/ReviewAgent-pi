# 参考项目：外部克隆的仓库（deepseek-harness / pi），不属于本项目源码
reference_project/

# API key 本机注入（推荐名 REVIEWER_API_KEY，旧名 DEEPSEEK_API_KEY 兼容；
# 绝不入库）
.env.local
.env

# Claude Code 本机配置（每台机器不同，不入库）
.claude/settings.local.json

# .claude/skills 是指向 .agents/skills 的 NTFS junction（本机链接，不入库；
# 真实的 skills 存储在 .agents/skills/，随仓库提交）
.claude/skills

# Claude Code 本机运行产物（/implement-spec 子代理 worktree / 崩溃转储）
.claude/worktrees/
*.stackdump

# Node 工程产物
node_modules/
dist/
coverage/
*.tsbuildinfo
# pi 内核包工具产物（packages/ai generate-model-catalog 输出目标 ../../.artifacts/）
.artifacts/

# 检视运行审计痕迹（runReview 默认落盘目录；数据/记录一律不入库——
# #32 / ADR-0014：结论文档例外随研究线退役，全量报告在 Demo 线）
runs/**

# review-pi CLI 缺省输出目录（#7 --out 缺省 review-pi-output；审计与运行记录不入库）
review-pi-output/

# reviewagent CLI 缺省输出目录（review / rpc / disposition 共用 --out 缺省；审计与运行记录不入库）
reviewagent-output/

# 会话草稿（to-tickets / grilling 工作稿，不入库）
.scratch/

# 脚本编译临时目录（tsc 即编即跑的 outDir）
.tmp-gen/
.tmp-gen-host/

# 数据集清单生成脚本下载缓存（scripts/generate-*-manifest.ts）
.cache/
