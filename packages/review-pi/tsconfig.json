{
  // 继承根 tsconfig，但显式回退两个加严 flags 并放开 allowImportingTsExtensions：
  // vendored pi 包的 exports.types 指向 TS 源（packages/*/src/index.ts），本包 import
  // pi-ai 时其源码会进入本程序——pi 基线（tsconfig.base.json，strict-only）扛不住
  // 根级 noUncheckedIndexedAccess / exactOptionalPropertyTypes（探测约 40 处违例），
  // 且其源码使用 ".ts" 后缀 import（需 allowImportingTsExtensions，仅限 noEmit）。
  // 本包自有代码仍按严格纪律编写；回退仅是对 vendored 依赖的让步。
  // dist 构建（tsconfig.build.json）经 paths 映射 pi-ai 的 d.ts，不受此影响。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
