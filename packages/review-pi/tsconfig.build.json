{
  // dist 构建程序不能包含 pi 源码：emit 程序禁用 allowImportingTsExtensions，
  // 且 pi src 在 rootDir 之外会触发 TS6059。故经 paths 将 @earendil-works/pi-ai
  // 全部映射到其 dist 的 d.ts（skipLibCheck 跳过检查，仅消费公开 API 面），
  // 同时恢复根级全量严格 flags（本包自有代码按最严标准构建）。
  // review-llm（冻结仪器常量单源）同理映射到其 dist d.ts（prepare 在
  // pnpm install 时构建）。pi-ai dist 的 types.d.ts 会 import
  // @earendil-works/pi-telemetry——不映射则按 node_modules 解析回其 src
  //（exports.types 指向 TS 源）触发 TS5097，故同样映射到 telemetry dist
  // d.ts。@earendil-works/pi-agent-core（P3a agentLoop/Agent 缝）同因映射
  // ——其 exports.types 亦指向 TS 源，且 vendored 源的严格 flags 与本程序
  // 不一致（noUncheckedIndexedAccess/exactOptionalPropertyTypes 均报错）；
  // 其 dist 的 harness d.ts 再 import @earendil-works/chord（注意无 pi-
  // 前缀），chord 同因映射到自身 dist d.ts（其 dist 无再外引，链条终止）。src/e2e（真跑冒烟 e2e 基础设施）不进 dist。
  // 前置：先 pnpm build:pi 产出 pi 四包 dist（pi 为 vendored 冻结基线，
  // 与 pnpm-workspace 的 onlyBuiltDependencies 策略一致，不做 install 自动构建）。
  // src/bytegate（#5 P2 字节纪律门）是纯测试基建——比较器/真源发现/门
  // runner/对照——不进 dist（同 src/testing 口径）。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-ai": ["../ai/dist/index.d.ts"],
      "@earendil-works/pi-ai/*": ["../ai/dist/*.d.ts"],
      "@earendil-works/pi-telemetry": ["../telemetry/dist/index.d.ts"],
      "@earendil-works/pi-agent-core": ["../agent/dist/index.d.ts"],
      "@earendil-works/chord": ["../chord/dist/index.d.ts"],
      "@earendil-works/chord/*": ["../chord/dist/*.d.ts", "../chord/dist/*/index.d.ts"],
      "review-llm": ["../review-llm/dist/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/testing", "src/e2e", "src/bytegate", "node_modules", "dist"]
}
