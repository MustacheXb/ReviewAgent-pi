{
  "name": "review-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pi 内核线 Review Runtime（#3）：controller / Zone 组装 / 解析 / 审计投影，内核变量面从 0 重写（ADR-0009）",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "workspace:*",
    "@vscode/ripgrep": "1.18.0",
    "tree-sitter-java": "0.23.5",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
