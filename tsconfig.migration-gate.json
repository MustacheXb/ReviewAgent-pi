{
  // 迁移门脚本编译程序（#14）：入口 scripts/run-migration-gate.ts + import 闭包
  // （src/gate → src/experiment/pi-kernel → review-pi，经 paths 消费其 dist d.ts）。
  // 同 tsconfig.experiment.json 先例必须走 -p 而非内联 flags：内联 flags 忽略
  // tsconfig → baseUrl/paths 失效 → review-pi 类型链解析回 vendored pi src 而
  // 编译爆炸。files + include 覆盖（extends 的 include 不残留）：只编入口及其
  // 闭包，产物 .tmp-gen/scripts/run-migration-gate.js 与 node 调用路径一致；
  // rootDir 不钉——入口在 scripts/、闭包在 src/，公共根即仓库根。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": ".tmp-gen"
  },
  "files": ["scripts/run-migration-gate.ts"],
  "include": [],
  "exclude": ["node_modules", "dist", ".tmp-gen"]
}
