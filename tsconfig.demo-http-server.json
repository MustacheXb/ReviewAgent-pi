{
  // HTTP server demo 脚本编译程序（#28）：入口 scripts/demo-http-server.ts，
  // 经 paths 消费 review-pi dist d.ts（ReviewHttpClient 公开面）。同
  // tsconfig.migration-gate.json 先例必须走 -p 而非内联 flags：内联 flags
  // 忽略 tsconfig → baseUrl/paths 失效 → review-pi 类型链解析回 vendored
  // pi src 而编译爆炸。files + include 覆盖（extends 的 include 不残留）：
  // 只编入口及其闭包，产物 .tmp-gen/scripts/demo-http-server.js 与 node
  // 调用路径一致；rootDir 不钉——入口在 scripts/、闭包在 workspace 包，公共根即仓库根。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": ".tmp-gen",
    "rootDir": "."
  },
  "files": ["scripts/demo-http-server.ts"],
  "include": [],
  "exclude": ["node_modules", "dist", ".tmp-gen", ".artifacts"]
}
