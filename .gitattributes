# 数据集交付物按字节入库：manifest 的 diffSha256 完整性校验依赖原始字节，
# 必须禁用 core.autocrlf 的换行转换（否则 Windows 检出 LF→CRLF 导致 sha256 校验失败）
data/clean-mr/diffs/** -text

# pi 内核 model data 同理：packages/ai 的 check:model-data 按原始字节 sha256
# 对照 .manifest.json 校验（build:pi 前置门），检出时 LF→CRLF 会使哈希全部失配
packages/ai/src/providers/data/** -text

# review-pi 黄金 fixture 按字节入库：Zone A 跨 MR 字节稳定断言依赖原始字节
# （vul4j-1.diff 含 git diff 原生形态的「单空格」空上下文行，换行转换会破坏一致性）；
# 合成样本仓库一并禁用转换，保证跨平台检出字节一致
packages/review-pi/testdata/** -text

# 只读 RunRecord 分析器报告 golden（#37）：报告 schema 以固定字节锁定，
# Windows autocrlf 的 LF→CRLF 转换会让 golden 测试在检出后假红
tests/eval/testdata/** -text

# npm bin 入口必须 LF：shebang 行 CRLF 会使 Unix 执行面 /usr/bin/env 'node\r'
# 失败，pnpm pack 也直接拒收（ERR_PNPM_BIN_CRLF）——Windows autocrlf 检出
# 会静默转换，故按 eol=lf 钉死（tarball 安装冒烟在本机 Windows 可复现的门）
packages/reviewagent/bin/** text eol=lf
